{
  "name": "wedding-invitation",
  "private": true,
  "type": "module",
  "scripts": {
    "setup": "npm install && npm install --prefix client",
    "dev": "concurrently -n api,web \"node --watch server/index.js\" \"npm run dev --prefix client\"",
    "build": "npm run build --prefix client",
    "start": "node server/index.js"
  },
  "dependencies": {
    "@supabase/supabase-js": "^2.45.0",
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "express": "^4.19.2"
  },
  "devDependencies": { "concurrently": "^8.2.2" }
}
